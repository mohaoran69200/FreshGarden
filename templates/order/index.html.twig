{% extends 'base.html.twig' %}

{% block title %}Mes Commandes - Fresh Garden{% endblock %}
{% block meta_description %}La liste de toutes mes commandes.{% endblock %}
{% block body %}
    <section class="section-container">
        <h2>Mes Commandes</h2>

        <div class="order-details">
            <table class="table">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Total</th>
                    <th>Date de Création</th>
                    <th>Statut</th>
                    <th>Action</th>
                </tr>
                </thead>
                <tbody>
                {% for order in orders %}
                    <tr>
                        <td>{{ order.id }}</td>
                        <td>{{ order.total }} €</td>
                        <td>{{ order.createdAt|date('Y-m-d H:i') }}</td>
                        <td>{{ order.status.value }}</td>
                        <td>
                            {% if order.status.value == 'En attente' %}
                                <a href="{{ path('app_order_new') }}" class="view-btn">Voir</a>
                            {% else %}
                                <a href="{{ path('app_order_show', { id: order.id }) }}" class="view-btn">Voir</a>
                            {% endif %}

                            {% if order.status.value == 'En attente' %}
                                <a href="{{ path('app_order_cancel', { id: order.id }) }}" class="delete-btn">Annuler</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            {% if orders is empty %}
                <p>Aucune commande trouvée.</p>
            {% endif %}
        </div>
    </section>
{% endblock %}
