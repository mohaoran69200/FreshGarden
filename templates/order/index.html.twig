{% extends 'base.html.twig' %}

{% block title %}Mes Commandes{% endblock %}

{% block body %}
    <h1>Mes Commandes</h1>

    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Total</th>
            <th>Date de Création</th>
            <th>Statut</th>
            <th>Action</th>
        </tr>
        </thead>
        <tbody>
        {% for order in orders %}
            <tr>
                <td>{{ order.id }}</td>
                <td>{{ order.total }} €</td>
                <td>{{ order.createdAt|date('Y-m-d H:i') }}</td>
                <td>{{ order.status.name }}</td>
                <td>
                    <a href="{{ path('app_order_show', { id: order.id }) }}" class="view-btn">Voir</a>
                    {% if order.status.name == 'En_attente' %}
                        <a href="{{ path('app_order_cancel', { id: order.id }) }}" class="delete-btn">Annuler</a>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if orders is empty %}
        <p>Aucune commande trouvée.</p>
    {% endif %}
{% endblock %}
