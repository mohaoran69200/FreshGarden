{% extends 'base.html.twig' %}

{% block title %}Nouvelle commande{% endblock %}

{% block body %}
    <h1>Nouvelle commande</h1>

    <div class="order-summary">
        <h3>Produits sélectionnés</h3>
        <table class="table">
            <thead>
            <tr>
                <th>Produit</th>
                <th>Quantité</th>
                <th>Prix unitaire</th>
                <th>Total</th>

            </tr>
            </thead>
            <tbody>
            {% set totalAmount = 0 %} {# Initialisation du montant total #}
            {% for orderLine in order.orderLines %}
                {% set lineTotal = orderLine.product.price * orderLine.quantity %}
                {% set totalAmount = totalAmount + lineTotal %} {# Ajout du total de la ligne au montant total #}
                <tr>
                    <td>{{ orderLine.product.name }}</td>
                    <td>{{ orderLine.quantity }}</td>
                    <td>{{ orderLine.product.price }} €</td>
                    <td>{{ lineTotal }} €</td>
{#                    <td>#}
{#                        {% if orderLine.deliveryMode is defined %}#}
{#                            {{ form_row(orderLine.deliveryMode) }}#}
{#                        {% else %}#}
{#                            <p>Mode de livraison non défini</p>#}
{#                        {% endif %}#}
{#                    </td>#}
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="total">
            <strong>Total de la commande :</strong> {{ totalAmount }} €
        </div>
    </div>

    <h3>Choisissez votre mode de livraison</h3>
    <div class="delivery-method">
        {{ form_start(form) }}
        {{ form_widget(form) }}
        <div class="form-actions">
            <button type="submit" class="view-btn">Confirmer la commande</button>
            <a href="{{ path('app_order') }}" class="delete-btn">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
