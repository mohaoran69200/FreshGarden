{% extends 'base.html.twig' %}

{% block title %}Modifier le mot de passe{% endblock %}
{% block importmap %}{{ importmap(['app', 'password', 'header']) }}{% endblock %}
{% block body %}
    <h2>Modifier le mot de passe</h2>

    <div class="form-container">
        {{ form_start(form) }}

        <div class="form-group">
            {{ form_label(form.current_password) }}
            <div class="input-with-eye">
                {{ form_widget(form.current_password, { 'attr': {'class': 'form-control password-input', 'autocomplete': 'current-password'} }) }}
                <label for="{{ form.current_password.vars.id }}" class="toggle-password" style="cursor: pointer;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mdp">
                        <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                        <path fill-rule="evenodd" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" clip-rule="evenodd" />
                    </svg>
                </label>
            </div>
            {{ form_errors(form.current_password) }}
        </div>

        <div class="form-group">
            {{ form_label(form.new_password) }}
            <div class="input-with-eye">
                {{ form_widget(form.new_password, { 'attr': {'class': 'form-control password-input', 'autocomplete': 'new-password'} }) }}
                <label for="{{ form.new_password.vars.id }}" class="toggle-password" style="cursor: pointer;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mdp">
                        <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                        <path fill-rule="evenodd" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" clip-rule="evenodd" />
                    </svg>
                </label>
            </div>
            {{ form_errors(form.new_password) }}
        </div>

        <div class="form-group">
            {{ form_label(form.confirm_password) }}
            <div class="input-with-eye">
                {{ form_widget(form.confirm_password, { 'attr': {'class': 'form-control password-input', 'autocomplete': 'new-password'} }) }}
                <label for="{{ form.confirm_password.vars.id }}" class="toggle-password" style="cursor: pointer;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mdp">
                        <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                        <path fill-rule="evenodd" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" clip-rule="evenodd" />
                    </svg>
                </label>
            </div>
            {{ form_errors(form.confirm_password) }}
        </div>



        <button type="submit" class="btn btn-primary">Modifier le mot de passe</button>

        {{ form_end(form) }}
    </div>

{% endblock %}
