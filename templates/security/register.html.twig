{% extends 'base.html.twig' %}

{% block title %}
	Inscription - Fresh Garden
{% endblock %}
{% block meta_description %}S'inscrire à Fresh Garden{% endblock %}
{% block importmap %}{{ importmap(['app', 'password', 'header']) }}{% endblock %}
{% block body %}
	<div class="form-container">
		<h1>Rejoignez-nous</h1>

		{{ form_errors(registrationForm) }}

		{{ form_start(registrationForm) }}

		<div class="form-group">
			{{ form_label(registrationForm.email) }}
			{{ form_widget(registrationForm.email, {'attr': {'class': 'form-control'}}) }}
			<div class="text-danger">
				{{ form_errors(registrationForm.email) }}
			</div>
		</div>

		<div class="form-group password-group">
			{{ form_label(registrationForm.plainPassword.first) }}
			<div class="input-with-eye">
				{{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-control password-input', 'autocomplete': 'new-password'}}) }}
				<label for="{{ registrationForm.plainPassword.first.vars.id }}" class="toggle-password" style="cursor: pointer;">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mdp">
						<path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
						<path fill-rule="evenodd" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" clip-rule="evenodd" />
					</svg>
				</label>
			</div>
			<div class="text-danger">
				{{ form_errors(registrationForm.plainPassword.first) }}
			</div>
		</div>

		<div class="form-group password-group">
			{{ form_label(registrationForm.plainPassword.second) }}
			<div class="input-with-eye">
				{{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-control password-input', 'autocomplete': 'new-password'}}) }}
				<label for="{{ registrationForm.plainPassword.second.vars.id }}" class="toggle-password" style="cursor: pointer;">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mdp">
						<path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
						<path fill-rule="evenodd" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" clip-rule="evenodd" />
					</svg>
				</label>
			</div>
			<div class="text-danger">
				{{ form_errors(registrationForm.plainPassword.second) }}
			</div>
		</div>
		<p>Votre mot de passe doit contenir au moins 8 caractères, une majuscule, une minuscule et un caractère spécial</p>

		<div class="terms__container">
			{{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'checkbox'}}) }}
			{{ form_label(registrationForm.agreeTerms, null, {'label_attr': {'class': 'terms'}}) }}
			<div class="text-danger">
				{{ form_errors(registrationForm.agreeTerms) }}
			</div>
		</div>

		<button type="submit" class="btn-primary">S'inscrire</button>
		<p>Vous êtes déjà inscrit? <a href="{{ path('login') }}" class="link-button">Connectez-vous</a></p>

		{{ form_end(registrationForm) }}
	</div>

{% endblock %}
