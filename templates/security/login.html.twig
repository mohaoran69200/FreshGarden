{% extends 'base.html.twig' %}

{% block title %}
	Connexion - Fresh Garden
{% endblock %}
{% block meta_description %}Se connecter à Fresh Garden{% endblock %}
{% block importmap %}
	{{ importmap(['app', 'password', 'header']) }}
{% endblock %}

{% block body %}
	<div class="form-container">
		<form method="post" action="{{ path('login') }}">
			{% if app.request.hasSession() %}
				{% set error = app.session.get('security_error') %}
				{% if error %}
					<div class="error-message">{{ error|trans({}, 'security') }}</div>
				{% endif %}
			{% endif %}

			{% if app.user %}
				<div class="form-footer">
					{{ app.user.userIdentifier }},
					<a href="{{ path('logout') }}" class="btn btn-primary">Se déconnecter</a>
				</div>
			{% else %}
				<h1 class="h3 mb-3 font-weight-normal">Se connecter</h1>
				<div class="form-group">
					<label for="username">Email</label>
					<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus>
				</div>
				<div class="form-group password-group">
					<label for="password">Mot de passe</label>
					<div class="input-with-eye">
						<input type="password" name="_password" id="password" class="form-control password-input" autocomplete="current-password" required>
						<label for="password" class="toggle-password" style="cursor: pointer;">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mdp">
								<path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
								<path fill-rule="evenodd" d="M1.323 11.447C2.811 6.976 7.028 3.75 12.001 3.75c4.97 0 9.185 3.223 10.675 7.69.12.362.12.752 0 1.113-1.487 4.471-5.705 7.697-10.677 7.697-4.97 0-9.186-3.223-10.675-7.69a1.762 1.762 0 0 1 0-1.113ZM17.25 12a5.25 5.25 0 1 1-10.5 0 5.25 5.25 0 0 1 10.5 0Z" clip-rule="evenodd" />
							</svg>
						</label>
					</div>
				</div>

				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

				<button class="btn-primary" type="submit">Se connecter</button>
				<p><a href="{{ path('app_forgot_password_request') }}" class="link-button">Mot de passe oublié</a></p>
				<p>Vous n'avez pas de compte? <a href="{{ path('register') }}" class="link-button">Inscrivez-vous ici</a></p>
			{% endif %}
		</form>
	</div>
{% endblock %}
