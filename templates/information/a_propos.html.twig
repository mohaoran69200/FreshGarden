{% extends 'base.html.twig' %}

{% block title %}À propos de Fresh Garden{% endblock %}

{% block body %}
    <main class="about-container">
        <header class="about-header">
            <h1>À propos de Fresh Garden</h1>
            <p class="about-intro">
                Bienvenue chez Fresh Garden, votre partenaire de confiance pour des produits frais, locaux et de qualité.
            </p>
        </header>

        <section class="about-section">
            <h2>Notre Histoire</h2>
            <p>
                Fresh Garden a été fondé en 2024 avec une mission simple : rapprocher les consommateurs des producteurs locaux.
                Nous croyons fermement que manger sainement et soutenir l'économie locale peut transformer notre quotidien.
            </p>
        </section>

        <section class="about-section">
            <h2>Notre Mission</h2>
            <p>
                Offrir à nos clients des produits frais et durables, tout en promouvant une agriculture responsable et respectueuse de l'environnement.
            </p>
        </section>

        <section class="about-section">
            <h2>Nos Valeurs</h2>
            <ul class="about-values">
                <li><strong>Qualité :</strong> Garantir des produits frais et soigneusement sélectionnés.</li>
                <li><strong>Proximité :</strong> Favoriser les circuits courts et les producteurs locaux.</li>
                <li><strong>Durabilité :</strong> Réduire notre impact environnemental à chaque étape.</li>
            </ul>
        </section>

        <section class="about-section">
            <h2>Nous Contacter</h2>
            <p>
                Une question ou un commentaire ? Nous serions ravis de vous entendre :
            </p>
            <ul class="about-contact">
                <li><strong>Email :</strong> <a href="mailto:contact@freshgarden.com">contact@freshgarden.com</a></li>
                <li><strong>Téléphone :</strong> +33 6 13 17 46 68</li>
                <li><strong>Adresse :</strong> 63 boulevard Ambroise Croizat, 69200 Vénissieux, France</li>
            </ul>
        </section>

        <footer class="about-footer">
            <p>
                Merci de faire partie de l'aventure Fresh Garden. Ensemble, cultivons un avenir plus sain et plus durable.
            </p>
        </footer>
    </main>
{% endblock %}
