{% extends 'base.html.twig' %}

{% block title %}Recherchez{% endblock %}

{% block body %}
        <section class="search-section">
            {{ form_start(form, {'action': path('app_search'), 'method': 'GET', 'attr': {'class': 'search-form'}}) }}

            <div class="form-row">
                <div class="search-input">
                    {{ form_widget(form.search, {'attr': {'class': 'form-control', 'placeholder': 'Rechercher un produit...'}}) }}
                    {{ form_errors(form.search) }}
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    {{ form_widget(form.categorie, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.categorie) }}
                </div>
                <div class="form-group">
                    {{ form_widget(form.city, {'attr': {'class': 'form-control', 'placeholder': 'Ville'}}) }}
                    {{ form_errors(form.city) }}
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <div class="input-symbol">
                        {{ form_widget(form.minPrice, {'attr': {'class': 'form-control', 'placeholder': 'Prix minimum'}}) }}
                        <span class="currency-symbol">€</span>
                    </div>
                    {{ form_errors(form.minPrice) }}
                </div>
                <div class="form-group">
                    <div class="input-symbol">
                        {{ form_widget(form.maxPrice, {'attr': {'class': 'form-control', 'placeholder': 'Prix maximum'}}) }}
                        <span class="currency-symbol">€</span>
                    </div>
                    {{ form_errors(form.maxPrice) }}
                </div>
            </div>

            <!-- Ligne 4 : Bouton de recherche -->
            <div class="form-row">
                <button type="submit" class="search-btn">Rechercher</button>
            </div>

            {{ form_end(form) }}
        </section>


        <section class="products-section">
            <h2>Nos Produits</h2>
            <div class="grid-container">
                <div class="grid">
                    {% for product in results %}
                        {% set isFavorite = favorites[product.id] ?? false %}
                        {% include '_partials/product/_cardProductSmall.html.twig' with { 'product': product, 'isFavorite': isFavorite } %}
                    {% else %}
                        <p>Aucun produit trouvé.</p>
                    {% endfor %}
                </div>
                {% include '_partials/_pagination.html.twig' with {'pagination': results} %}
            </div>
        </section>
{% endblock %}
