{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}

    <div class="cart-container">
        <h1>Mon panier</h1>

        {% if cart|length == 0 %}
            <div class="empty-cart">
                <p>Aucun article dans votre panier.</p>
            </div>
        {% else %}
            {% set total = 0 %}
            {% for item in cart %}
                <div class="cart-item">
                    <div>
                        <a href="{{ path('app_product_show', {'id': item.product.id}) }}">{{ item.product.name }}</a>
                        <p>{{ item.product.price }}€</p>
                    </div>

                    <div>
                        <form action="{{ path('cart_update_quantity', { id: item.product.id, quantity: 0 }) }}" method="post">
                            <label for="quantity-{{ item.product.id }}">Quantité :</label>
                            <select id="quantity-{{ item.product.id }}" name="quantity" class="quantity-select" onchange="this.form.submit();">
                                {% for i in 1..item.product.stock %}
                                    <option value="{{ i }}" {% if i == item.quantity %}selected{% endif %}>{{ i }}</option>
                                {% endfor %}
                            </select>
                        </form>
                    </div>

                    <div>
                        <a href="{{ path('cart_remove', {id: item.product.id}) }}">Retirer</a>
                    </div>
                </div>
                {% set total = total + (item.product.price * item.quantity) %}
            {% endfor %}




            <div class="total-container">
                <h3>Total: {{ total }}€</h3>
            </div>

            <div class="total-container">
                <a href="{{ path('app_order_new') }}" class="checkout-btn">Commander</a>
            </div>

        {% endif %}
    </div>
{% endblock %}
