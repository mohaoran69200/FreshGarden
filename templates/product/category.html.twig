{% extends 'base.html.twig' %}

{% block title %}{{ categorie }}{% endblock %}

{% block body %}
    <main>
        <section>
            <h2>Annonces de {{ categorie }}</h2>
            <div class="grid-container">
                <div class="grid">
                    {% for product in products %}
                        {% include '_partials/product/_cardProductSmall.html.twig' with { 'product': product, 'isFavorite': isFavorite } %}
                    {% else %}
                        <p>Aucun produit disponible dans cette catégorie.</p>
                    {% endfor %}
                </div>
            </div>

            {% include '_partials/_pagination.html.twig' with {'pagination': products} %}
        </section>
    </main>
{% endblock %}
