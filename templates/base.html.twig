<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>
		{% block title %}
			Fresh Garden
		{% endblock %}
	</title>
	<meta name="description" content="{% block meta_description %}Découvrez Fresh Garden, votre plateforme dédiée aux fruits et légumes frais et locaux. Commandez en ligne des produits de qualité près de chez vous !{% endblock %}">
	<link rel="icon" type="image/png" href="{{ asset('logo/logo_fresh_garden-removebg.png') }}" sizes="32x32">

	{% block stylesheets %}
		<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">
	{% endblock %}

	{% block javascripts %}
		{% block importmap %}
			{{ importmap(['app', 'header', 'form', 'address']) }}
		{% endblock %}
	{% endblock %}
</head>

<body>
<div class="wrapper">
	{% block header %}
		{% include '_partials/_header.html.twig' %}
	{% endblock %}
	{% include '_partials/_flash_messages.html.twig' %}

	<main>
		{% block body %}
		{% endblock %}
	</main>
	{% include'_partials/_cookie.html.twig' %}
	{% block footer %}
		{% include '_partials/_footer.html.twig' %}
	{% endblock %}
</div>
</body>
</html>
