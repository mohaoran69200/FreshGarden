<header>
    <nav class="nav">
        <a href="{{ path('home') }}" class="logo">
            <figure>
                <img src="{{ asset('logo/logo_fresh_garden-removebg.png') }}" alt="Logo de Fresh Garden"/>
            </figure>
        </a>

        <ul class="desktop-menu">
            <li>
                <a href="{{ path('home') }}">accueil</a>
            </li>
            <li>
                <a href="{{ path('app_product_fruits') }}">fruits</a>
            </li>
            <li>
                <a href="{{ path('app_product_legumes') }}">légumes</a>
            </li>
            <li>
                <a href="{{ path('app_product_autres') }}">produits divers</a>
            </li>
            {% if is_granted('ROLE_ADMIN') %}
                <li>
                    <a href="{{ path('app_admin_dashboard') }}">accueil administrateur</a>
                </li>
            {% endif %}
        </ul>

        <div id="search">
            <form action="{{ path('app_search') }}" method="get">
                <input type="text" id="search-input" name="search" placeholder="Rechercher un produit" value="{{ app.request.get('search') }}">
                <button id="search-button" type="submit" aria-label="Rechercher">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/>
                    </svg>
                </button>
            </form>
        </div>

        <ul class="btn-nav">
            <li>
                <a id="message-button" href="{{ path('message_index') }}" aria-label="Acceder aux messages">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
                    </svg>
                </a>
            </li>
            <li>
                <a id="cart-button" href="{{ path('cart_index') }}" aria-label="Acceder au panier">
                    <svg class="feather feather-shopping-cart" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="9" cy="21" r="1"/>
                        <circle cx="20" cy="21" r="1"/>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    </svg>
                </a>
            </li>
            <li>
                <a id="favorite-button" href="{{ path('app_favorite_index') }}" aria-label="Acceder à mes favoris">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
                    </svg>
                </a>
            </li>
            <li class="dropdown">
                <button id="connexion-button" aria-label="Menu utilisateur">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM12 14.25c-4.97 0-9 2.29-9 5.25v1.5h18v-1.5c0-2.96-4.03-5.25-9-5.25Z"/>
                    </svg>
                </button>
                <div class="dropdown-content">
                    {% if app.user is not null and app.user is defined %}
                        {% if is_granted('ROLE_USER') %}
                            <a href="{{ path('app_order', {id: app.user.id}) }}" aria-label="Acceder à mes commandes">mes commandes</a>
                        {% endif %}
                        <a href="{{ path('app_user_show', {id: app.user.id}) }}" aria-label="Acceder à mon profil">mon profil</a>
                        <a href="{{ path('logout') }}" aria-label="Se deconnecter">déconnexion</a>
                    {% else %}
                        <a href="{{ path('login') }}" aria-label="Se connecter">connexion</a>
                        <a href="{{ path('register') }}" aria-label="S'inscrire">inscription</a>
                    {% endif %}
                </div>
            </li>
        </ul>

        <div id="burger-menu" class="burger-menu">
            <span></span>
            <span></span>
            <span></span>
        </div>

    </nav>

    <div id="mobile-menu" class="mobile-menu">
        <button id="close-menu" class="close-menu">&times;</button>

        <ul class="pages">
            <li>
                <a href="{{ path('home') }}">acceuil</a>
            </li>
            <li>
                <a href="{{ path('app_product_fruits') }}">fruits</a>
            </li>
            <li>
                <a href="{{ path('app_product_legumes') }}">légumes</a>
            </li>
            <li>
                <a href="{{ path('app_product_autres') }}">autres</a>
            </li>
            {% if app.user is not null and app.user is defined %}
                <li>
                    <a href="{{ path('logout') }}">se déconnecter</a>
                </li>
            {% endif %}
        </ul>
    </div>

    <ul class="sticky-buttons">
        <li>
            <a id="message-button" href="{{ path('message_index') }}" aria-label="Acceder à mes messages">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
                </svg>
            </a>
        </li>
        <li>
            <a id="cart-button" href="{{ path('cart_index') }}" aria-label="Acceder à mon panier">
                <svg class="feather feather-shopping-cart" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="9" cy="21" r="1"/>
                    <circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
            </a>
        </li>
        <li>
            <a id="favorite-button" href="{{ path('app_favorite_index') }}" aria-label="Acceder à mes favoris">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
                </svg>
            </a>
        </li>

        <li>
            {% if app.user is not null and app.user is defined %}
                <a href="{{ path('app_user_show', {id: app.user.id}) }}" id="connexion-button" aria-label="Acceder à mon profil utilisateur">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM12 14.25c-4.97 0-9 2.29-9 5.25v1.5h18v-1.5c0-2.96-4.03-5.25-9-5.25Z"/>
                    </svg>
                </a>
            {% else %}
                <a href="{{ path('login') }}" id="connexion-button" aria-label="Acceder à mon profil utilisateur">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-7">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM12 14.25c-4.97 0-9 2.29-9 5.25v1.5h18v-1.5c0-2.96-4.03-5.25-9-5.25Z"/>
                    </svg>
                </a>
            {% endif %}
        </li>
    </ul>
</header>
