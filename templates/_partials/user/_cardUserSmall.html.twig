<div class="user-card card">
	<a href="{{ path('app_user_show', { id: user.id }) }}" class="user-card-link">
		{% if user.userProfile and user.userProfile.imageName %}
			<img src="{{ vich_uploader_asset(user.userProfile, 'imageFile') }}" alt="Photo de profil" class="user-profile-pic" loading="lazy">
		{% else %}
			<img src="{{ asset('images/utilisateur.png') }}" alt="Photo de profil par défaut" class="user-profile-pic" loading="lazy">
		{% endif %}
		<div class="user-card-content">
			<h3>{{ user.email }}</h3>
			<span class="user-name">
        {% if user.userProfile and (user.userProfile.userName or user.userProfile.firstName) %}
			{{ user.userProfile.userName ?: user.userProfile.firstName }}
		{% else %}
			Profil non disponible
		{% endif %}
    </span>
			<span class="user-city">{{ user.userProfile.city }}</span>

			<div class="actions-user-small">
				<a href="{{ path('message_send', { id: user.id }) }}">
					<button class="contact-button">Contacter</button>
				</a>
				<form action="{{ path('app_favorite_toggle_user', { id: user.id }) }}" method="post" class="favorite-form">
					<input type="hidden" name="_token" value="{{ csrf_token(isFavorite ? 'remove_user_' ~ user.id : 'add_user_' ~ user.id) }}">
					<button type="submit" class="favorite-button {{ isFavorite ? 'active' : '' }}" aria-label="{{ isFavorite ? 'Retirer des favoris' : 'Ajouter aux favoris' }}">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-width="1.5" class="size-7">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
						</svg>
					</button>
				</form>

			</div>

			<div class="ads-count">
				<a href="{{ path('app_user_show', {id: user.id}) }}#user-ads">{{ user.products|length }} annonces</a>
			</div>
		</div>
	</a>
</div>
