{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe{% endblock %}

{% block body %}
    <h1>Réinitialisez votre mot de passe</h1>

    {{ form_start(requestForm) }}
    <div class="form-group">
        {{ form_label(requestForm.email, 'Votre adresse e-mail') }}
        {{ form_widget(requestForm.email, { 'attr': {'class': 'form-control'} }) }}
        {{ form_errors(requestForm.email) }}
    </div>

    <button type="submit" class="btn-primary">Envoyer la demande de réinitialisation</button>
    {{ form_end(requestForm) }}
{% endblock %}
